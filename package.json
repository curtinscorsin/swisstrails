{
  "name": "swiss-trails-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:marketing": "turbo run dev --filter=swiss-trails-marketing",
    "dev:app": "turbo run dev --filter=swiss-trails-app",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "audit:content": "pnpm --filter swiss-trails-app audit:content",
    "audit:launch": "pnpm --filter swiss-trails-app audit:launch"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
