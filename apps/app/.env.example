# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only. Never prefix this with NEXT_PUBLIC or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public URL used for checkout redirects and auth links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true only when intentionally previewing without authentication.
NEXT_PUBLIC_MOCK_MODE=false

# Optional integrations already used by the app.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SECRET_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=
