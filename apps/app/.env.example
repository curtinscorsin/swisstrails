# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only. Never prefix this with NEXT_PUBLIC or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public URL used for checkout redirects and auth links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true only when intentionally previewing without authentication.
NEXT_PUBLIC_MOCK_MODE=false

# Fail-safe launch switch. Checkout remains unavailable until this is true and
# every required Stripe, Supabase, URL, and legal-operator value is configured.
NEXT_PUBLIC_SALES_ENABLED=false

# Required before accepting payment. These appear in legal disclosures.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_COUNTRY=Switzerland
SUPPORT_EMAIL=hello@swiss-trails.com

# Optional integrations already used by the app.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SECRET_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=
